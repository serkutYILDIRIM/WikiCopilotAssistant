@{
    ViewData["Title"] = Localizer["ErrorTitle"];
}

<section class="card border-0 shadow-sm p-4 p-md-5" aria-labelledby="error-title">
    <h1 id="error-title" class="h2">@Localizer["ErrorTitle"]</h1>
    <p class="text-secondary">@Localizer["ErrorDescription"]</p>
    <div>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">@Localizer["ReturnHome"]</a>
    </div>
</section>
