<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@Localizer["ApplicationDescription"]" />
    <title>@ViewData["Title"] - @Localizer["ApplicationName"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">@Localizer["SkipNavigation"]</a>
    <header class="border-bottom bg-white">
        <nav class="container py-3" aria-label="@Localizer["NavigationLabel"]">
            <a class="brand text-decoration-none" asp-controller="Home" asp-action="Index">
                @Localizer["ApplicationName"]
            </a>
        </nav>
    </header>
    <main id="main-content" class="container py-5" tabindex="-1">
        @RenderBody()
    </main>
    <footer class="container border-top py-4">
        <p class="text-secondary small mb-0">@Localizer["FooterNotice"]</p>
    </footer>
</body>
</html>
