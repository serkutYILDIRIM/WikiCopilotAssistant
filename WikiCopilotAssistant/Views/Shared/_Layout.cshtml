<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · WikiCopilot</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/chat.js" asp-append-version="true" defer></script>
</head>
<body>
    <header class="site-header">
        <a class="brand" href="/" aria-label="WikiCopilot ana sayfa"><span class="brand-mark" aria-hidden="true">W</span>WikiCopilot<span class="local-label">YEREL</span></a>
        <button type="button" class="button quiet" data-open-login>Copilot'a nasıl bağlanırım?</button>
    </header>
    <main class="page">@RenderBody()</main>
    <footer class="site-footer">Kendi Copilot hesabınız. İzin verdiğiniz kaynaklar. Geçici sohbet.</footer>
</body>
</html>
